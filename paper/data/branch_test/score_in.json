[{"id": "steel_197cbc77_t5_claude", "ref_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Steel \u2014 Wireframe</title>\n<style>\n  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\n  body{font-family:Georgia,serif;background:#ffffff;color:#000000}\n  .page{max-width:1080px;margin:0 auto;min-height:1080px;background:#ffffff;display:flex;flex-direction:column;justify-content:center}\n  .b{background:#ffffff;border:1px solid #000000;border-radius:2px;display:flex;align-items:center;justify-content:center;font-family:monospace;font-size:30px;color:#000000;letter-spacing:.04em;overflow:hidden;min-width:120px;min-height:76px}\n  /* Was position:absolute against .page \u2014 that anchored it to the page's\n     TOP regardless of where the (now vertically centered) .grid content\n     ends up, leaving it stranded far from the grid. In-flow with matching\n     margin instead, so it moves together with .grid as one centered unit. */\n  .banner-slot{margin:32px 0 0 40px;width:360px;height:34px}\n  .grid{display:grid;grid-template-columns:220px 1fr 200px;gap:26px;padding:0 30px 72px}\n  .panel{background:#ffffff;padding:79px 14px 29px;display:flex;flex-direction:column;gap:14px;margin-bottom:32px;position:relative}\n  .col{display:flex;flex-direction:column;gap:29px}\n  .ctnr{position:relative}\n  .ctag{position:absolute;top:4px;right:4px;z-index:5;background:#ffffff;color:#ffffff;font-family:monospace;font-size:24px;letter-spacing:.03em;padding:3px 6px;border-radius:2px;pointer-events:none}\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <!-- Skewed banner above the grid: 367px wide inside a 1080px page (~34%),\n       fails the header literal-identification test (no <header> tag, not\n       full-width) \u2014 kept as a plain leaf box, not wrapped in a container. -->\n  <div class=\"b banner-slot\">box-1</div>\n  <div class=\"grid\">\n    <!-- Left sidebar column (220px): narrow layout wrapper, but the <aside>\n         itself has no background of its own \u2014 same page background as the\n         grid \u2014 so it is not a container. Each .panel inside DOES have a\n         real background (#2b323c) distinct from the page (#171b21), so\n         each panel gets its own container instead (container-1/2/3, top to\n         bottom). -->\n    <aside class=\"col\">\n      <div class=\"panel\">\n        <span class=\"ctag\">container-1</span>\n        <div class=\"b y\" style=\"height:16px;width:80%\">box-2</div>\n        <div class=\"b\" style=\"height:14px;width:90%\">box-3</div>\n        <div class=\"b\" style=\"height:14px;width:70%\">box-4</div>\n      </div>\n      <div class=\"panel\">\n        <span class=\"ctag\">container-2</span>\n        <div class=\"b y\" style=\"height:15px;width:55%\">box-5</div>\n        <div class=\"b\" style=\"height:13px;width:75%\">box-6</div>\n        <div class=\"b\" style=\"height:13px;width:60%\">box-7</div>\n      </div>\n    </aside>\n    <!-- Centre <main> column: same reasoning \u2014 the column wrapper has no\n         background of its own, but the remaining .panel does, so it gets\n         its own container (container-3). -->\n    <main class=\"col\">\n      <div class=\"panel\"><span class=\"ctag\">container-3</span><div class=\"b y\" style=\"height:18px;width:46%\">box-8</div><div class=\"b\" style=\"height:180px\">box-9</div></div>\n    </main>\n    <!-- Right sidebar column (200px): same reasoning as the left sidebar\n         above \u2014 the <aside> wrapper is not a container, but each .panel is\n         (container-4/5, top to bottom). -->\n    <aside class=\"col\">\n      <div class=\"panel\"><span class=\"ctag\">container-4</span><div class=\"b y\" style=\"height:16px;width:90%\">box-10</div><div class=\"b\" style=\"height:288px\">box-11</div></div>\n      <div class=\"panel\"><span class=\"ctag\">container-5</span><div class=\"b\" style=\"height:30px;width:80%\">box-12</div><div class=\"b\" style=\"height:14px;width:50%\">box-13</div></div>\n    </aside>\n  </div>\n</div>\n</body>\n</html>\n", "gen_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Layout</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 30px; font-family: Arial, sans-serif; background: #fff; }\n  .box {\n    border: 1px solid #000;\n    background: #fff;\n    padding: 5px;\n    text-align: center;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  #box-1 {\n    width: 5cm;\n    height: 2cm;\n    margin: 0 auto 40px auto;\n  }\n  .middle {\n    display: flex;\n    gap: 50px;\n    align-items: flex-start;\n    justify-content: center;\n  }\n  .col {\n    display: flex;\n    flex-direction: column;\n    gap: 25px;\n    align-items: center;\n  }\n  .center-col {\n    display: flex;\n    flex-direction: column;\n    gap: 25px;\n    align-items: center;\n  }\n  .right-col {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n  }\n  .right-col #box-10 { margin-bottom: 4px; }\n  .right-col #box-11 { margin-bottom: 100px; }\n  .right-col #box-12 { margin-bottom: 25px; }\n\n  /* smallest: 2cm */\n  #box-2, #box-4, #box-10, #box-5, #box-7, #box-13 {\n    width: 2cm;\n    height: 2cm;\n  }\n\n  /* 0.5cm longer: 2.5cm */\n  #box-6, #box-12, #box-3 {\n    width: 2.5cm;\n    height: 2.5cm;\n  }\n\n  /* 3cm */\n  #box-8 {\n    width: 3cm;\n    height: 3cm;\n  }\n\n  /* box-11: 1.5cm wide, 5cm tall */\n  #box-11 {\n    width: 1.5cm;\n    height: 5cm;\n  }\n\n  /* box-9: 8cm wide, 2cm tall */\n  #box-9 {\n    width: 8cm;\n    height: 2cm;\n  }\n</style>\n</head>\n<body>\n  <div id=\"box-1\" class=\"box\">box-1</div>\n\n  <div class=\"middle\">\n    <div class=\"col\">\n      <div id=\"box-2\" class=\"box\">box-2</div>\n      <div id=\"box-3\" class=\"box\">box-3</div>\n      <div id=\"box-4\" class=\"box\">box-4</div>\n      <div id=\"box-5\" class=\"box\">box-5</div>\n      <div id=\"box-6\" class=\"box\">box-6</div>\n      <div id=\"box-7\" class=\"box\">box-7</div>\n    </div>\n\n    <div class=\"center-col\">\n      <div id=\"box-8\" class=\"box\">box-8</div>\n      <div id=\"box-9\" class=\"box\">box-9</div>\n    </div>\n\n    <div class=\"right-col\">\n      <div id=\"box-10\" class=\"box\">box-10</div>\n      <div id=\"box-11\" class=\"box\">box-11</div>\n      <div id=\"box-12\" class=\"box\">box-12</div>\n      <div id=\"box-13\" class=\"box\">box-13</div>\n    </div>\n  </div>\n</body>\n</html>"}, {"id": "midcentury_0f360a73_t2_claude", "ref_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Mid Century \u2014 Wireframe</title>\n<style>\n  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\n  body{font-family:Georgia,serif;background:#ffffff;color:#ffffff}\n  .page{max-width:1080px;margin:0 auto;background:#ffffff;min-height:1080px;display:flex;flex-direction:column;justify-content:center}\n  .b{background:#ffffff;border:1px solid #000000;border-radius:3px;display:flex;align-items:center;justify-content:center;font-family:monospace;font-size:30px;color:#000000;letter-spacing:.04em;overflow:hidden;min-width:120px;min-height:55px}\n  /* hnav (justify-content:flex-end) hugs the right edge, same corner as the\n     container-1 badge \u2014 was align-items:center in a fixed 78px bar, which\n     doesn't clear the badge at any height. Top-aligned with matching top\n     padding instead, same fix as .card/.panel/header (stickynotes). */\n  header{background:#ffffff;border:1px dashed #000000;display:flex;align-items:flex-start;justify-content:space-between;padding:57px 30px 21px}\n  .htitles{display:flex;flex-direction:column;gap:9px}\n  .hnav{display:flex;gap:8px;flex-wrap:wrap;width:520px;justify-content:flex-end}\n  .cards{display:flex;gap:18px;padding:34px 30px}\n  .cards .b{flex:1;height:241px}\n  .body{display:grid;grid-template-columns:230px 1fr;gap:26px;padding:0 30px 39px}\n  .col{display:flex;flex-direction:column;gap:16px}\n  .foot{background:#ffffff;border:1px dashed #000000;display:flex;gap:14px;padding:21px 30px;flex-wrap:wrap}\n  .ctnr{position:relative}\n  .ctag{position:absolute;top:4px;right:4px;z-index:5;background:rgba(255, 255, 255, 0.55);color:#000000;font-family:monospace;font-size:24px;letter-spacing:.03em;padding:3px 6px;border-radius:2px;pointer-events:none}\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <!-- Genuine <header> tag, full-width bar at the top: header container. -->\n  <header class=\"ctnr\">\n    <span class=\"ctag\">container-1</span>\n    <div class=\"htitles\">\n      <div class=\"b\" style=\"width:220px;height:26px\">box-1</div>\n    </div>\n    <div class=\"hnav\">\n      <div class=\"b\" style=\"width:120px;height:14px\">box-2</div>\n      <div class=\"b\" style=\"width:90px;height:14px\">box-3</div>\n      <div class=\"b\" style=\"width:110px;height:14px\">box-4</div>\n    </div>\n  </header>\n\n  <div class=\"cards\">\n    <div class=\"b\">box-5</div>\n    <div class=\"b\">box-6</div>\n    <div class=\"b\">box-7</div>\n  </div>\n\n  <div class=\"body\">\n    <!-- Left column: narrow (230px), structurally distinct from the wide\n         (1fr) right column, but it and its children (box-8/9/10) use the\n         same .b styling as ordinary page content \u2014 no visual boundary of\n         its own \u2014 so container-2 was removed and its boxes are now plain\n         leaves. -->\n    <div class=\"col\">\n      <div class=\"b\" style=\"height:22px;width:80%\">box-8</div>\n      <div class=\"b\" style=\"height:195px\">box-9</div>\n      <div class=\"b\" style=\"height:117px\">box-10</div>\n    </div>\n    <div class=\"col\">\n      <div class=\"b\" style=\"height:24px;width:50%\">box-11</div>\n      <div class=\"b\" style=\"height:91px\">box-12</div>\n      <div class=\"b\" style=\"height:117px\">box-13</div>\n    </div>\n  </div>\n\n  <!-- Bottom-most full-width bar: footer container (no <footer> tag, but\n       passes the literal \"bottom-most full-width bar\" test). -->\n  <div class=\"foot ctnr\">\n    <span class=\"ctag\">container-2</span>\n    <div class=\"b\" style=\"width:70px;height:16px\">box-14</div>\n    <div class=\"b\" style=\"width:60px;height:16px\">box-15</div>\n  </div>\n</div>\n</body>\n</html>\n", "gen_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tom Fold Deco</title>\n<style>\nbody {\n  font-family: Arial, sans-serif;\n  background: #fff;\n  color: #000;\n  margin: 20px;\n}\n.container {\n  position: relative;\n  border: 1px dashed #000;\n  background: #fff;\n  padding: 20px;\n  display: flex;\n  align-items: center;\n}\n.container-label {\n  position: absolute;\n  top: 4px;\n  right: 4px;\n  border: 1px solid #000;\n  background: #fff;\n  font-size: 10px;\n  padding: 1px 3px;\n}\n.box {\n  border: 1px solid #000;\n  background: #fff;\n  padding: 8px 14px;\n}\n.right-group {\n  margin-left: auto;\n  display: flex;\n  gap: 20px;\n}\n</style>\n</head>\n<body>\n<div class=\"container\">\n  <span class=\"container-label\">container-1</span>\n  <div class=\"box\">box-1</div>\n  <div class=\"right-group\">\n    <div class=\"box\">box-2</div>\n    <div class=\"box\">box-3</div>\n    <div class=\"box\">box-4</div>\n  </div>\n</div>\n</body>\n</html>"}, {"id": "midcentury_0f360a73_t2_human_replay", "ref_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Mid Century \u2014 Wireframe</title>\n<style>\n  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\n  body{font-family:Georgia,serif;background:#ffffff;color:#ffffff}\n  .pa