:14px\">box-3</div>\n      <div class=\"b\" style=\"width:110px;height:14px\">box-4</div>\n    </div>\n  </header>\n\n  <div class=\"cards\">\n    <div class=\"b\">box-5</div>\n    <div class=\"b\">box-6</div>\n    <div class=\"b\">box-7</div>\n  </div>\n\n  <div class=\"body\">\n    <!-- Left column: narrow (230px), structurally distinct from the wide\n         (1fr) right column, but it and its children (box-8/9/10) use the\n         same .b styling as ordinary page content \u2014 no visual boundary of\n         its own \u2014 so container-2 was removed and its boxes are now plain\n         leaves. -->\n    <div class=\"col\">\n      <div class=\"b\" style=\"height:22px;width:80%\">box-8</div>\n      <div class=\"b\" style=\"height:195px\">box-9</div>\n      <div class=\"b\" style=\"height:117px\">box-10</div>\n    </div>\n    <div class=\"col\">\n      <div class=\"b\" style=\"height:24px;width:50%\">box-11</div>\n      <div class=\"b\" style=\"height:91px\">box-12</div>\n      <div class=\"b\" style=\"height:117px\">box-13</div>\n    </div>\n  </div>\n\n  <!-- Bottom-most full-width bar: footer container (no <footer> tag, but\n       passes the literal \"bottom-most full-width bar\" test). -->\n  <div class=\"foot ctnr\">\n    <span class=\"ctag\">container-2</span>\n    <div class=\"b\" style=\"width:70px;height:16px\">box-14</div>\n    <div class=\"b\" style=\"width:60px;height:16px\">box-15</div>\n  </div>\n</div>\n</body>\n</html>\n", "gen_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Tom Fold Deco</title>\n<style>\nbody {\n  font-family: Arial, sans-serif;\n  background: #fff;\n  color: #000;\n  margin: 20px;\n}\n.container {\n  position: relative;\n  border: 1px dashed #000;\n  background: #fff;\n  padding: 20px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n.nav-group {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n}\n.box {\n  border: 1px solid #000;\n  background: #fff;\n  padding: 8px 14px;\n}\n</style>\n</head>\n<body>\n<div class=\"container\">\n  <div class=\"box\">Tom Fold Deco</div>\n  <div class=\"nav-group\">\n    <div class=\"box\">Home</div>\n    <div class=\"box\">Offers</div>\n    <div class=\"box\">FAQ</div>\n  </div>\n</div>\n</body>\n</html>"}, {"id": "retro_006de8ef_t1_claude", "ref_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Retro \u2014 Wireframe</title>\n<style>\n  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\n  body{font-family:'Comic Sans MS',Georgia,serif;background:#ffffff;color:#000000}\n  .page{max-width:1080px;margin:0 auto;min-height:1080px;background:#ffffff;padding:31px 0;display:flex;flex-direction:column;justify-content:center}\n  .col{width:520px;margin:0 auto;background:#ffffff;padding:31px 22px;display:flex;flex-direction:column;gap:14px;align-items:center}\n  .b{background:#ffffff;border:1px solid #000000;border-radius:3px;display:flex;align-items:center;justify-content:center;font-family:monospace;font-size:30px;color:#000000;letter-spacing:.04em;overflow:hidden;min-width:120px;min-height:71px}\n  .row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}\n  .full{width:100%}\n  .ctnr{position:relative}\n  .ctag{position:absolute;top:4px;right:4px;z-index:5;color:#000000;font-family:monospace;font-size:24px;letter-spacing:.03em;padding:3px 6px;border-radius:2px;pointer-events:none}\n</style>\n</head>\n<body>\n<!-- Only one container in this file: it's a single narrow (520px, ~48% of\n     the 1080px page) centered column \u2014 the topmost banner (text-1, now\n     box-1) fails the literal full-page-width test for a header, same\n     reasoning as steel's rejected banner, and there is no side column\n     structurally distinct from a main area, so no sidebar either. The\n     nested .col below (box-9 through box-13) DOES have a genuine visual\n     boundary \u2014 solid fill distinct from the page background \u2014 so it\n     becomes container-1. Every other box in this file (box-1 through\n     box-8) stays plain. All box-level accent classes (rainbow/yellow/\n     black/magenta/dashed) were removed corpus-wide for color consistency\n     \u2014 every box is now the same white fill regardless of role. -->\n<div class=\"page\">\n  <div class=\"col\">\n    <div class=\"b full\" style=\"height:34px\">box-1</div>\n    <div class=\"b full\" style=\"height:18px;width:70%\">box-2</div>\n    <div class=\"row full\">\n      <div class=\"b\" style=\"width:130px;height:75px\">box-3</div>\n      <div class=\"b\" style=\"height:75px;flex:1\">box-4</div>\n    </div>\n    <div class=\"row\"><div class=\"b\" style=\"width:40px;height:34px\">box-5</div><div class=\"b\" style=\"width:60px;height:34px\">box-6</div><div class=\"b\" style=\"width:40px;height:34px\">box-7</div></div>\n    <div class=\"b full\" style=\"height:20px;width:50%\">box-8</div>\n    <div class=\"col ctnr\" style=\"width:90%;gap:10px;padding:75px 22px 24px; border:1px dashed #000000\">\n      <span class=\"ctag\">container-1</span>\n      <div class=\"b full\" style=\"height:14px;width:70%\">box-9</div>\n      <div class=\"b full\" style=\"height:14px;width:55%\">box-10</div>\n      <div class=\"b full\" style=\"height:14px;width:65%\">box-11</div>\n      <div class=\"b full\" style=\"height:14px;width:60%\">box-12</div>\n      <div class=\"b full\" style=\"height:14px;width:50%\">box-13</div>\n    </div>\n  </div>\n</div>\n</body>\n</html>\n", "gen_html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Layout</title>\n<style>\n  body {\n    background: #fff;\n    font-family: Arial, sans-serif;\n    margin: 20px auto;\n    width: 1080px;\n  }\n  .box {\n    border: 1px solid #000