# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Same Supabase project as the human study (reads study_references; writes
# to the new a2a_sessions/a2a_messages tables only — never conversations/messages).
SUPABASE_URL=

# SERVICE-ROLE key — bypasses RLS to write the a2a_* tables.
# Dashboard → Project Settings → API → service_role (secret). Keep it local only.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — generator model must match the human study exactly.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
