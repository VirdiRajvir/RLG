# Copy to .env and fill in. .env is gitignored — never commit the service key.

# Supabase project URL (same as the app's VITE_SUPABASE_URL).
SUPABASE_URL=

# SERVICE-ROLE key — bypasses RLS to write the study_* tables.
# Dashboard → Project Settings → API → service_role (secret). Keep it local only.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — same key + model the app uses, so candidates match production.
OPENROUTER_API_KEY_FREE=
OPENROUTER_MODEL=arcee-ai/trinity-large-preview:free
